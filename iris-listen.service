[Unit]
Description=iris-listen: Qwen3-ASR speech to text (server.py)
# install.sh fills in the placeholders.
After=default.target

[Service]
Type=simple
ExecStart=HERE_DIR/.venv/bin/python HERE_DIR/server.py HOST_ARGS --port LISTEN_PORT --model MODEL_DIR --token-file TOKEN_PATH
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
